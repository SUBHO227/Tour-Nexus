# Leave DATABASE_URL unset to use a local SQLite file (./tournexus.db).
# That is the fastest way to run the project for a demo.
#
# For PostgreSQL + PostGIS, uncomment and fill in your own credentials:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/tournexus

# Secret used to sign JWT access tokens. Generate your own for any real
# deployment, e.g.  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-in-production
JWT_EXPIRE_MINUTES=1440

# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5500,http://127.0.0.1:5500
